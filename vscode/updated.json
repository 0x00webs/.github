            "gateway": true,
            "library": true,
            "module": true,
            "provider": true,
            "resolver": true,
            "resource": true,
            "service": true,
            "start": true,
            "startDebug": true,
            "startDev": true,
            "startProd": true
        }
    }, // Activate items in the submenu
    "nestjs.submenu.customCommands": [
        {
            "args": "--flat",
            "command": "nest g co",
            "name": "Template 1"
        },
        {
            "args": "--no-flat",
            "command": "nest g co",
            "name": "Template 2"
        }
    ], // The list of custom commands to execute in the custom command submenu
    "nestjs.submenu.templates": [
        {
            "description": "Description of Template 1",
