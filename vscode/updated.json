{
  // *****************************
  // ** github copilot settings **
  // *****************************
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": true
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".copilot-commit-message-instructions.md"
    },
    {
      "text": "Use conventional commit message format."
    }
  ],
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.editor.enableAutoCompletions": true,
  // *********************
  // ** EDITOR SETTINGS **
  // *********************
  "editor.fontSize": 10,
  "editor.fontFamily": "Maple Mono",
  "editor.fontLigatures": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,
  "editor.renderLineHighlight": "all",
  "editor.lineHeight": 18,
  "editor.letterSpacing": 0.5,
  "editor.suggestFontSize": 10,
  "editor.suggestLineHeight": 25,
  "editor.suggest.filterGraceful": false,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggest.showIcons": true,
  "editor.suggest.insertMode": "replace",
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showKeywords": true,
  "editor.suggest.showSnippets": true,
  "editor.suggest.showClasses": true,
  "editor.suggest.showConstructors": true,
  "editor.suggest.showFields": true,
  "editor.suggest.showMethods": true,
  "editor.suggest.showVariables": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showModules": true,
  "editor.suggest.showProperties": true,
  "editor.suggest.showEvents": true,
  "editor.suggest.showOperators": true,
  "editor.suggest.showStructs": true,
  "editor.suggest.showEnums": true,
  "editor.suggest.showInterfaces": true,
  "editor.suggest.showValues": true,
  "editor.suggest.showConstants": true,
  "editor.suggest.showColors": true,
  "editor.suggest.showFiles": true,
  "editor.suggest.showReferences": true,
  "editor.suggest.showFolders": true,
  "editor.suggest.showTypeParameters": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.detectIndentation": true,
  "editor.insertSpaces": false,
  "editor.scrollbar.verticalScrollbarSize": 0,
  "editor.scrollbar.horizontalScrollbarSize": 0,
  "editor.find.addExtraSpaceOnTop": true,
  "editor.comments.insertSpace": true,
  "editor.autoIndent": "full",
  "editor.bracketPairColorization.enabled": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeActionsOnSave": {
    "source.addMissingImports.ts": "always",
    "source.fixAll.markdownlint": "always",
    "source.removeUnused.ts": "always",
    "source.sortImports": "always",
    "source.organizeImports": "always",
    "source.fixAll.eslint": "always",
    "source.fixAll": "always",
    "source.removeUnusedImports": "always",
    "addMissingImports": "always"
  },
  "editor.codeLensFontFamily": "Maple Mono",
  "editor.codeLensFontSize": 10,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 5,
  "editor.fontWeight": 1000,
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "gotoAndPeek",
  "editor.guides.bracketPairs": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlayHints.enabled": "on",
  "editor.linkedEditing": true,
  "editor.smartSelect.selectLeadingAndTrailingWhitespace": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.rulers": [
    80
  ],
  "editor.trimAutoWhitespace": true,
  "editor.scrollBeyondLastLine": false,
  "editor.showFoldingControls": "always",
  "editor.snippetSuggestions": "top",
  "editor.stickyScroll.enabled": true,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": true,
  "editor.unfoldOnClickAfterEndOfLine": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "editor.cursorStyle": "block",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": false,
  "editor.quickSuggestions": {
    "comments": "on",
    "other": "on",
    "strings": "on"
  },
  "editor.autoSurround": "languageDefined",
  "editor.autoClosingDelete": "always",
  "editor.inlineSuggest.enabled": true,
  "editor.colorDecorators": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.autoClosingQuotes": "always",
  "editor.smoothScrolling": true,
  "editor.inlayHints.padding": true,
  "editor.cursorBlinking": "expand",
  "editor.minimap.enabled": true,
  "editor.minimap.showSlider": "always",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 80,
  "editor.minimap.size": "proportional",
  "editor.minimap.scale": 1,
  "editor.minimap.side": "right",
  "editor.hover.enabled": "on",
  "editor.hover.sticky": true,
  "editor.hover.delay": 300,
  "editor.lineNumbers": "on",
  "editor.folding": true,
  "editor.glyphMargin": true,
  // Controls whether suggestions should be accepted on commit characters. For example, in JavaScript, the semi-colon (`;`) can be a commit character that accepts a suggestion and types that character.
  "editor.acceptSuggestionOnCommitCharacter": true,
  // Controls if suggestions should be accepted on 'Enter' - in addition to 'Tab'. Helps to avoid ambiguity between inserting new lines or accepting suggestions. The value 'smart' means only accept a suggestion with Enter when it makes a textual change
  "editor.acceptSuggestionOnEnter": "on",
  // Controls the delay in ms after which quick suggestions will show up.
  "editor.quickSuggestionsDelay": 10,
  // Controls if suggestions should automatically show up when typing trigger characters
  "editor.suggestOnTriggerCharacters": true,
  // Controls if pressing tab inserts the best suggestion and if tab cycles through other suggestions
  "editor.tabCompletion": "on",
  // Controls whether sorting favours words that appear close to the cursor
  "editor.suggest.localityBonus": true,
  // Controls how suggestions are pre-selected when showing the suggest list
  "editor.suggestSelection": "first",
  // Enable word based suggestions
  "editor.wordBasedSuggestions": "matchingDocuments",
  // Enable parameter hints
  "editor.parameterHints.enabled": true,
  // ********************
  // ** EMMET SETTINGS **
  // ********************
  "emmet.triggerExpansionOnTab": true,
  "emmet.showAbbreviationSuggestions": true,
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.useInlineCompletions": true,
  // ***********************
  // ** EXPLORER SETTINGS **
  // ***********************
  "explorer.compactFolders": false,
  "explorer.autoReveal": false,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.enabled": true,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.decorations.colors": true,
