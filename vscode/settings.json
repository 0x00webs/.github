{
	// *****************************
	// ** GitHub Copilot settings **
	// *****************************
	"github.copilot.enable": {
		"*": true,
		"plaintext": true,
		"markdown": true,
		"scminput": true
	},
	"github.copilot.chat.commitMessageGeneration.instructions": [
		{
			"file": ".copilot-commit-message-instructions.md"
		},
		{
			"text": "Use conventional commit message format."
		}
	],
	"github.copilot.editor.enableCodeActions": true,
	"github.copilot.editor.enableAutoCompletions": true,
	"github.copilot.nextEditSuggestions.enabled": true,
	// *********************
	// ** EDITOR SETTINGS **
	// *********************
	// Core
	"editor.fontSize": 14,
	"editor.fontFamily": "Maple Mono",
	"editor.fontLigatures": true,
	"editor.fontWeight": 1000,
	"editor.lineHeight": 25,
	"editor.letterSpacing": 0.5,
	"editor.cursorStyle": "block",
	"editor.cursorWidth": 5,
	"editor.cursorBlinking": "expand",
	"editor.cursorSmoothCaretAnimation": "on",
	// Tabs / indentation / whitespace
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.detectIndentation": false, // set false to respect insertSpaces:false
	"editor.trimAutoWhitespace": true,
	"editor.renderWhitespace": "all",
	"editor.renderControlCharacters": true,
	"editor.trimAutoWhitespace": true,
	"editor.trimFinalNewlines": true,
	// Layout & wrapping
	"editor.wordWrap": "on",
	"editor.scrollBeyondLastLine": false,
	"editor.rulers": [
		80
	],
	"editor.lineNumbers": "on",
	"editor.minimap.enabled": true,
	"editor.minimap.showSlider": "always",
	"editor.minimap.renderCharacters": false,
	"editor.minimap.maxColumn": 80,
	"editor.minimap.size": "proportional",
	"editor.minimap.scale": 1,
	"editor.minimap.side": "right",
	// Selection & cursors
	"editor.selectionHighlight": false,
	"editor.occurrencesHighlight": "singleFile",
	"editor.hideCursorInOverviewRuler": true,
	"editor.cursorBlinking": "expand",
	"editor.quickSuggestions": {
		"comments": "on",
		"other": "on",
		"strings": "on"
	},
	"editor.quickSuggestionsDelay": 10,
	"editor.inlineSuggest.enabled": true,
	"editor.acceptSuggestionOnEnter": "on",
	"editor.acceptSuggestionOnCommitCharacter": true,
	"editor.suggestOnTriggerCharacters": true,
	"editor.tabCompletion": "on",
	"editor.suggest.insertMode": "replace",
	"editor.suggest.preview": true,
	"editor.suggest.showStatusBar": true,
	"editor.suggest.localityBonus": true,
	"editor.suggestSelection": "first",
	"editor.wordBasedSuggestions": "matchingDocuments",
	// UI / helpers
	"editor.renderLineHighlight": "all",
	"editor.guides.bracketPairs": true,
	"editor.guides.highlightActiveBracketPair": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
	"editor.hover.enabled": "on",
	"editor.hover.sticky": true,
	"editor.hover.delay": 300,
	"editor.stickyScroll.enabled": true,
	"editor.snippetSuggestions": "top",
	"editor.showFoldingControls": "always",
	"editor.folding": true,
	"editor.foldingStrategy": "indentation",
	"editor.unfoldOnClickAfterEndOfLine": true,
	"editor.linkedEditing": true,
	"editor.smartSelect.selectLeadingAndTrailingWhitespace": true,
	"editor.multiCursorModifier": "ctrlCmd",
	"editor.glyphMargin": true,
	"editor.find.addExtraSpaceOnTop": true,
	"editor.comments.insertSpace": true,
	"editor.autoIndent": "full",
	"editor.autoSurround": "languageDefined",
	"editor.autoClosingQuotes": "always",
	"editor.autoClosingDelete": "always",
	"editor.hover.sticky": true,
	"editor.smoothScrolling": true,
	"editor.colorDecorators": true,
	"editor.tokenColorCustomizations": {
		"[*Light*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#000"
					}
				}
			]
		},
		"[*Dark*]": {
			"textMateRules": [
				{
					"scope": "ref.matchtext",
					"settings": {
						"foreground": "#fff"
					}
				}
			]
		},
		"textMateRules": []
	},
	// Code actions / formatting
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true,
	"editor.formatOnType": true,
	"editor.codeActionsOnSave": {
		// Consolidated to deterministic actions, preserves auto-fix & import organization
		"source.organizeImports": "always",
		"source.fixAll": "always",
		"source.fixAll.eslint": "always",
		"source.removeUnusedImports": "always",
		"source.addMissingImports.ts": "always"
	},
	// Quick edit / navigation
	"editor.gotoLocation.multipleDeclarations": "goto",
	"editor.gotoLocation.multipleDefinitions": "goto",
	"editor.gotoLocation.multipleImplementations": "goto",
	"editor.gotoLocation.multipleReferences": "goto",
	"editor.gotoLocation.multipleTypeDefinitions": "gotoAndPeek",
	"editor.unfoldOnClickAfterEndOfLine": true,
	"editor.showFoldingControls": "always",
	// Suggestions visibility (explicit)
	"editor.suggest.showIcons": true,
	"editor.suggest.showKeywords": true,
	"editor.suggest.showSnippets": true,
	"editor.suggest.showClasses": true,
	"editor.suggest.showConstructors": true,
	"editor.suggest.showFields": true,
	"editor.suggest.showMethods": true,
	"editor.suggest.showVariables": true,
	"editor.suggest.showFunctions": true,
	"editor.suggest.showModules": true,
	"editor.suggest.showProperties": true,
	"editor.suggest.showEvents": true,
	"editor.suggest.showOperators": true,
	"editor.suggest.showStructs": true,
	"editor.suggest.showEnums": true,
	"editor.suggest.showInterfaces": true,
	"editor.suggest.showValues": true,
	"editor.suggest.showConstants": true,
	"editor.suggest.showColors": true,
	"editor.suggest.showFiles": true,
	"editor.suggest.showReferences": true,
	"editor.suggest.showFolders": true,
	"editor.suggest.showTypeParameters": true,
	"editor.suggest.showStatusBar": true,
	// Scrollbars & overview
	"editor.scrollBeyondLastLine": false,
	"editor.scrollbar.vertical": "hidden", // explicitly hide vertical scrollbar (keeps layout clean)
	// ********************
	// ** EMMET SETTINGS **
	// ********************
	"emmet.triggerExpansionOnTab": true,
	"emmet.showAbbreviationSuggestions": true,
	"emmet.showSuggestionsAsSnippets": true,
	"emmet.useInlineCompletions": true,
	// ***********************
	// ** EXPLORER SETTINGS **
	// ***********************
	"explorer.compactFolders": false,
	"explorer.autoReveal": false,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.component.ts": "$(capture).component.html, $(capture).component.spec.ts, $(capture).component.css, $(capture).component.scss, $(capture).component.sass, $(capture).component.less",
		"*.ts": "$(capture).js, $(capture).*.ts, $(capture)_*.js, $(capture)_*.ts",
		"*.tsx": "$(capture).ts, $(capture).*.tsx, $(capture)_*.ts, $(capture)_*.tsx",
		"*.js": "$(capture).js.map, $(capture).*.js, $(capture)_*.js",
		"*.jsx": "$(capture).js, $(capture).*.jsx, $(capture)_*.js, $(capture)_*.jsx",
		"*.css": "$(capture).css.map, $(capture).*.css",
		"*.scss": "$(capture).*.scss",
		"*.vue": "$(capture).*.ts, $(capture).*.js",
		"*.cshtml": "$(capture).cshtml.cs",
		".env": "*.env, .env.*, .envrc, env.d.ts"
		// Keep major patterns; trimmed some very niche entries for readability
	},
	"explorer.confirmDelete": true,
	"explorer.confirmDragAndDrop": true,
	"explorer.decorations.colors": true,
	// ***********************
	// ** WINDOW SETTINGS **
	// ***********************
	"window.zoomLevel": -1,
	"window.title": "${dirty}${activeEditorMedium}${separator}${rootName}${separator}${appName}",
	"window.newWindowDimensions": "inherit",
	"window.titleBarStyle": "custom",
	"window.autoDetectColorScheme": true,
	"window.commandCenter": true,
	"window.restoreFullscreen": true,
	"window.restoreWindows": "all",
	"window.dialogStyle": "custom",
	"window.zoomPerWindow": true,
	"window.customTitleBarVisibility": "auto",
	// ***********************
	// ** WORKBENCH SETTINGS **
	// ***********************
	"workbench.statusBar.visible": true,
	"workbench.editor.showTabs": "multiple",
	"workbench.tree.renderIndentGuides": "always",
	"workbench.tree.indent": 18,
	"workbench.editor.enablePreview": true,
	"workbench.editor.enablePreviewFromQuickOpen": true,
	"workbench.commandPalette.preserveInput": true,
	"workbench.editor.closeOnFileDelete": true,
	"workbench.editor.decorations.badges": true,
	"workbench.editor.decorations.colors": true,
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.editor.limit.enabled": true,
	"workbench.editor.limit.value": 20,
	"workbench.editor.revealIfOpen": true,
	"workbench.editor.wrapTabs": true,
	"workbench.layoutControl.enabled": true,
	"workbench.list.horizontalScrolling": true,
	"workbench.settings.openDefaultSettings": true,
	"workbench.view.alwaysShowHeaderActions": true,
	"workbench.preferredLightColorTheme": "Default Dark Modern",
	"workbench.iconTheme": "a-wl-file-icon-vscode",
	"workbench.productIconTheme": "a-wl-file-icon-vscode-product-icon-theme",
	// ********************
	// ** FILES SETTINGS **
	// ********************
	"files.autoSave": "afterDelay",
	"files.autoSaveDelay": 1000,
	"files.autoSaveWhenNoErrors": true,
	"files.simpleDialog.enable": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.associations": {
		"*.page-template": "vue",
		"*.layout-template": "vue",
		"*.vue": "vue",
		"*.js": "javascript",
		"*.jsx": "javascriptreact",
		"*.html": "html",
		"*.css": "css",
		"*.json": "json",
		"*.md": "markdown",
		"*.xml": "xml",
		"*.php": "php",
		"*.py": "python",
		"*.rb": "ruby",
		"*.erb": "erb",
		"*.go": "go",
		"*.java": "java",
		"*.c": "c",
		"*.cpp": "cpp",
		"*.h": "h",
		"*.hpp": "hpp",
		"*.cs": "csharp",
		"*.coffee": "coffeescript",
		"*.less": "less",
		"*.lua": "lua",
		"*.pl": "perl",
		"*.sql": "sql",
		"*.swift": "swift",
		"*.vb": "vb",
		"*.sh": "shellscript",
		"*.bat": "bat",
		"*.ps1": "powershell",
		"*.r": "r",
		"*.rust": "rust",
		"*.scala": "scala",
		"*.scss": "scss",
		"*.styl": "stylus",
		"*.ts": "typescript",
		"*.tsx": "typescriptreact",
		"*.yaml": "yaml",
		"*.yml": "yaml",
		"*.mdx": "markdown",
		".babelrc": "json",
		".huskyrc": "json",
		".env*": "dotenv"
	},
	"files.enableTrash": true,
	"files.refactoring.autoSave": true,
	"files.eol": "auto",
	"files.trimTrailingWhitespaceInRegexAndStrings": true,
	// ***********************
	// ** TERMINAL SETTINGS **
	// ***********************
	"terminal.integrated.cursorStyleInactive": "outline",
	"terminal.integrated.enableVisualBell": true,
	"debug.terminal.clearBeforeReusing": true,
	"terminal.integrated.fontSize": 18,
	"terminal.integrated.fontFamily": "MesloLGM Nerd Font",
	"terminal.integrated.fontWeight": "800",
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.cursorStyle": "line",
	"terminal.integrated.cursorWidth": 2,
	"terminal.integrated.letterSpacing": 0.5,
	"terminal.integrated.profiles.linux": {
		"bash": {
			"path": "bash",
			"icon": "terminal-bash"
		},
		"zsh": {
			"path": "zsh"
		},
		"fish": {
			"path": "fish"
		},
		"tmux": {
			"path": "tmux",
			"icon": "terminal-tmux"
		},
		"pwsh": {
			"path": "pwsh",
			"icon": "terminal-powershell"
		}
	},
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"source": "PowerShell",
			"icon": "terminal-powershell"
		},
		"Command Prompt": {
			"path": [
				"${env:windir}\\Sysnative\\cmd.exe",
				"${env:windir}\\System32\\cmd.exe"
			],
			"args": [],
			"icon": "terminal-cmd"
		},
		"Git Bash": {
			"source": "Git Bash"
		}
	},
	"terminal.external.windowsExec": "pwsh",
	"terminal.integrated.profiles.osx": {
		"bash": {
			"path": "bash",
			"icon": "terminal-bash"
		},
		"zsh": {
			"path": "zsh"
		},
		"fish": {
			"path": "fish"
		},
		"tmux": {
			"path": "tmux",
			"icon": "terminal-tmux"
		},
		"pwsh": {
			"path": "pwsh",
			"icon": "terminal-powershell"
		},
		"Ubuntu (WSL)": {
			"path": "wsl.exe",
			"args": [
				"-d",
				"Ubuntu"
			],
			"icon": "terminal-ubuntu"
		}
	},
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.integrated.defaultProfile.windows": "Git Bash",
	"terminal.integrated.defaultProfile.osx": "bash",
	"terminal.integrated.enableImages": true,
	"terminal.integrated.rightClickBehavior": "copyPaste",
	"terminal.integrated.copyOnSelection": true,
	"terminal.integrated.tabs.enabled": true,
	"terminal.integrated.tabs.location": "left",
	"terminal.integrated.tabs.enableAnimation": true,
	"terminal.integrated.shellIntegration.enabled": true,
	"terminal.external.linuxExec": "foot",
	"terminal.explorerKind": "external",
	"terminal.sourceControlRepositoriesKind": "both",
	"terminal.integrated.env.linux": {
		"NODE_ENV": "development",
		"EDITOR": "code",
		"VISUAL": "code",
		"GIT_EDITOR": "code",
		"PAGER": "less",
		"LESS": "-R"
	},
	// *********************
	// ** SEARCH SETTINGS **
	// *********************
	"search.exclude": {
		"**/node_modules": true,
		"**/bower_components": true,
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/CVS": true,
		"**/.DS_Store": true
	},
	"search.useIgnoreFiles": true,
	"search.quickOpen.includeSymbols": true,
	"search.quickOpen.includeHistory": true,
	// ******************
	// ** GIT SETTINGS **
	// ******************
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.enableCommitSigning": true,
	"git.autorefresh": true,
	"git.confirmForcePush": true,
	"git.openRepositoryInParentFolders": "always",
	// *************************
	// ** EXTENSIONS SETTINGS **
	// *************************
	"extensions.autoUpdate": true,
	"extensions.autoCheckUpdates": true,
	"extensions.ignoreRecommendations": false,
	"chat.editor.fontSize": 12,
	"scm.inputFontSize": 12,
	"diffEditor.maxComputationTime": 0,
	"remote.autoForwardPortsSource": "hybrid",
	// ****************
	// ** C / C++ settings
	// ****************
	"[c]": {
		"editor.defaultFormatter": "seaube.clangformat"
	},
	"C_Cpp.default.cStandard": "c89",
	"C_Cpp.refactoring.includeHeader": "always",
	"C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
	"C_Cpp.inlayHints.autoDeclarationTypes.showOnLeft": true,
	"C_Cpp.inlayHints.parameterNames.enabled": true,
	"C_Cpp.inlayHints.referenceOperator.enabled": true,
	"C_Cpp.inlayHints.referenceOperator.showSpace": true,
	"C_Cpp.autocomplete": "default",
	"C_Cpp.autocompleteAddParentheses": true,
	"C_Cpp.clang_format_sortIncludes": true,
	"C_Cpp.enhancedColorization": "enabled",
	"C_Cpp.vcFormat.indent.multiLineRelativeTo": "outermostParenthesis",
	"C_Cpp.vcFormat.indent.braces": true,
	"C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "newLine",
	"C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "newLine",
	"C_Cpp.vcFormat.space.afterComma": true,
	"C_Cpp.vcFormat.space.afterKeywordsInControlFlowStatements": true,
	"C_Cpp.vcFormat.space.removeAroundUnaryOperator": true,
	"C_Cpp.vcFormat.space.aroundBinaryOperator": "insert",
	"C_Cpp.vcFormat.space.aroundTernaryOperator": "insert",
	"C_Cpp.vcFormat.wrap.preserveBlocks": "never",
	"C_Cpp.clang_format_style": "{ BasedOnStyle: Microsoft, BreakBeforeBraces: Allman, UseTab: Always, IndentWidth: 4, TabWidth: 4, SeparateDefinitionBlocks: Always, AllowShortIfStatementsOnASingleLine: false, IndentCaseLabels: false, ColumnLimit: 0, AccessModifierOffset: -4, NamespaceIndentation: All }",
	"clangFormat.style": "{ BasedOnStyle: Microsoft, BreakBeforeBraces: Allman, UseTab: Always, IndentWidth: 4, TabWidth: 4, SeparateDefinitionBlocks: Always, AllowShortIfStatementsOnASingleLine: false, IndentCaseLabels: false, ColumnLimit: 0, AccessModifierOffset: -4, NamespaceIndentation: All, FixNamespaceComments: false }",
	"C_Cpp.commentContinuationPatterns": [
		"/**",
		"/**/"
	],
	"C_Cpp.doxygen.generatedStyle": "/**",
	// ********************
	// ** CMake settings **
	// ********************
	"cmake.configureOnOpen": true,
	// ***********************
	// ** Prettier settings **
	// ***********************
	"prettier.enable": true,
	"prettier.singleQuote": true,
	"prettier.trailingComma": "all",
	"prettier.printWidth": 80,
	"prettier.tabWidth": 4,
	"prettier.useTabs": true,
	"prettier.bracketSpacing": true,
	"prettier.bracketSameLine": true,
	"prettier.semi": true,
	"prettier.proseWrap": "preserve",
	"prettier.arrowParens": "always",
	"prettier.endOfLine": "auto",
	"prettier.jsxSingleQuote": true,
	"prettier.quoteProps": "consistent",
	// *******************
	// ** JSON settings **
	// *******************
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	// ******************
	// ** Vue settings **
	// ******************
	"vue.format.script.initialIndent": true,
	"vue.format.style.initialIndent": true,
	"vue.inlayHints.inlineHandlerLeading": true,
	"vue.inlayHints.missingProps": true,
	"vue.inlayHints.optionsWrapper": true,
	"vue.inlayHints.vBindShorthand": true,
	"vue.splitEditors.icon": true,
	"vue.autoInsert.bracketSpacing": true,
	"vue.codeActions.enabled": true,
	"vue.autoInsert.dotValue": true,
	"vue.complete.casing.props": "autoKebab",
	"vue.complete.casing.tags": "autoKebab",
	"vue.format.template.initialIndent": true,
	"vue.updateImportsOnFileMove.enabled": true,
	"[vue]": {
		"editor.defaultFormatter": "Vue.volar"
	},
	// ****************
	// ** JavaScript **
	// ****************
	"javascript.updateImportsOnFileMove.enabled": "always",
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"javascript.format.enable": true,
	"javascript.format.indentSwitchCase": true,
	"javascript.autoClosingTags": true,
	"javascript.format.insertSpaceAfterCommaDelimiter": true,
	"javascript.format.semicolons": "insert",
	"javascript.inlayHints.functionLikeReturnTypes.enabled": true,
	"javascript.inlayHints.parameterNames.enabled": "all",
	"javascript.inlayHints.parameterTypes.enabled": true,
	"javascript.inlayHints.variableTypes.enabled": true,
	"javascript.suggest.jsdoc.generateReturns": true,
	// ****************
	// ** Astro **
	// ****************
	"astro.content-intellisense": true,
	"astro.updateImportsOnFileMove.enabled": true,
	"[astro]": {
		"editor.defaultFormatter": "astro-build.astro-vscode"
	},
	// *********
	// ** CSS **
	// *********
	"[css]": {
		"editor.defaultFormatter": "vscode.css-language-features"
	},
	"scss.format.enable": true,
	"scss.completion.completePropertyWithSemicolon": true,
	"scss.completion.triggerPropertyValueCompletion": true,
	"scss.format.braceStyle": "expand",
	"scss.hover.documentation": true,
	"scss.format.newlineBetweenRules": true,
	"scss.format.newlineBetweenSelectors": true,
	"scss.hover.references": true,
	"[scss]": {
		"editor.suggest.insertMode": "replace",
		"editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter"
	},
	// *********
	// ** HTML **
	// *********
	"[html]": {
		"editor.suggest.insertMode": "replace",
		"editor.defaultFormatter": "vscode.html-language-features"
	},
	"html.autoClosingTags": true,
	"html.autoCreateQuotes": true,
	"html.completion.attributeDefaultValue": "doublequotes",
	"html.format.enable": true,
	"html.format.templating": true,
	"html.hover.documentation": true,
	"html.validate.scripts": true,
	"html.validate.styles": true,
	"html.format.indentInnerHtml": true,
	// ****************
	// ** Shell script **
	// ****************
	"shfmt.executablePath": "shfmt",
	"[shellscript]": {
		"files.eol": "\n",
		"editor.defaultColorDecorators": "never",
		"editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
	},
	"[manpage]": {
		"editor.guides.indentation": false
	},
	// Misc / third-party extension overrides
	"mssql.autoDisableNonTSqlLanguageService": true,
	"mssql.enableRichExperiences": true,
	"gitlens.ai.model": "gitkraken",
	"gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
	"RainbowBrackets.depreciation-notice": false,
	// Markdown / language overrides
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
	},
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	// Other small prefs
	"dotenv.enableAutocloaking": false,
	"remote.autoForwardPortsSource": "hybrid"
}
